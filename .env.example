# The store this service works for, and the app's credentials (Dev Dashboard →
# your app → Settings). scripts/dev.sh asks for these and writes them here.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Enables /api for server-to-server callers (Shopify Flow, backends).
# Keys are at least 32 characters: openssl rand -hex 32. Both empty = /api off.
# One key:
API_KEY=
# Or one per caller, named in the logs; also for rotating a key without downtime:
# API_KEYS=flow:<key>,erp:<key>

# Optional
# PORT=8080
# SHOPIFY_API_VERSION=2026-07
# DATA_DIR=/data                 # where the encrypted access token is kept
# PROXY_MAX_AGE=5m               # how old a signed App Proxy request may be
# RATE_LIMIT_PER_MINUTE=30       # App Proxy requests per customer (or IP) per minute
# LOG_LEVEL=info
# LOG_FORMAT=json                # or text
# SERVICE_NAMESPACE=shopify-app-service
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
